user nginx;

events {
    worker_connections 1024;
}

http {
    types_hash_max_size 2048;
    types_hash_bucket_size 128;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;

    map $host $hex_site {
        default "";
        "~^(?<hex_site_name>[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\.${HEX_SITE_DOMAIN_PATTERN}$" $hex_site_name;
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    map $host $hex_platform {
        default 0;
        "~^${HEX_SITE_DOMAIN_PATTERN}$" 1;
    }

    server {
        listen 8080;
        client_max_body_size 32m;
        absolute_redirect off;

        location = /healthz {
            access_log off;
            return 200 "ok\n";
        }

        location ~ /\. {
            return 404;
        }

        location = /.hex/authz {
            internal;
            proxy_pass http://127.0.0.1:8081/api/hex/authz;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host $http_host;
            proxy_set_header X-Hex-Site $hex_site;
        }

        location / {
            error_page 418 = @hex_platform;
            if ($hex_platform = 1) {
                return 418;
            }
            if ($hex_site = "") {
                return 404;
            }
            auth_request /.hex/authz;
            root /mnt/sites/public/sites/$hex_site;
            index index.html;
            autoindex off;
            disable_symlinks on;
            add_header X-Content-Type-Options nosniff always;
            add_header Cache-Control no-cache always;
            add_header Origin-Agent-Cluster "?1" always;
            try_files $uri $uri/ =404;
        }

        location @hex_platform {
            proxy_pass http://127.0.0.1:8081;
            proxy_set_header Host $http_host;
        }

        location /api/ {
            proxy_pass http://127.0.0.1:8081;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
            proxy_send_timeout 60s;
            proxy_buffering off;
        }

    }
}
