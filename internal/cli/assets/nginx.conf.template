user nginx;

events {
    worker_connections 1024;
}

http {
    types_hash_max_size 2048;
    types_hash_bucket_size 128;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;

    # Completed main requests only; no cookies, tokens, IPs or query strings.
    log_format hex_traffic escape=json
        '{"version":1,"id":"$request_id","time":"$msec",'
        '"site":"$hex_site","user":"$hex_analytics_user",'
        '"method":"$request_method","status":"$status",'
        '"bytes":"$body_bytes_sent","duration":"$request_time",'
        '"destination":"$http_sec_fetch_dest","contentType":"$sent_http_content_type",'
        '"api":"$hex_api_request"}';

    map $request_uri $hex_api_request {
        default 0;
        ~^/api/ 1;
    }

    map $hex_api_request $hex_analytics_user {
        default $hex_static_user;
        1 $upstream_http_x_hex_analytics_user;
    }

    map "${HEX_ANALYTICS_ENABLED}:$hex_site" $hex_log_traffic {
        default 1;
        ~^0: 0;
        "1:" 0;
    }

    access_log syslog:server=127.0.0.1:8082,tag=hex_traffic,nohostname hex_traffic if=$hex_log_traffic;

    map $host $hex_site {
        default "";
        "~^(?<hex_site_name>[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\.${HEX_SITE_DOMAIN_PATTERN}$" $hex_site_name;
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    map $host $hex_platform {
        default 0;
        "~^${HEX_SITE_DOMAIN_PATTERN}$" 1;
    }

    server {
        listen 8080;
        client_max_body_size 32m;
        absolute_redirect off;

        location = /healthz {
            access_log off;
            return 200 "ok\n";
        }

        # Optional remote MCP discovery is non-secret. All /mcp/ requests still
        # pass through the deployment's normal authentication boundary.
        location = /.well-known/oauth-protected-resource {
            proxy_pass http://127.0.0.1:8081;
            proxy_set_header Host $http_host;
        }

        location ~ /\. {
            return 404;
        }

        location = /.hex/authz {
            internal;
            proxy_pass http://127.0.0.1:8081/api/hex/authz;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host $http_host;
            proxy_set_header X-Hex-Site $hex_site;
            proxy_set_header X-Hex-Path $hex_path;
        }

        location / {
            error_page 418 = @hex_platform;
            if ($hex_platform = 1) {
                return 418;
            }
            if ($hex_site = "") {
                return 404;
            }
            # Path rules are checked against the decoded, normalized URI.
            # Inside the auth subrequest $uri is the subrequest's own path, so
            # capture it here; subrequests share the main request's variables.
            set $hex_path $uri;
            auth_request /.hex/authz;
            auth_request_set $hex_static_user $upstream_http_x_hex_analytics_user;
            root /mnt/sites/public/sites/$hex_site;
            index index.html;
            autoindex off;
            disable_symlinks on;
            add_header X-Content-Type-Options nosniff always;
            add_header Cache-Control no-cache always;
            add_header Origin-Agent-Cluster "?1" always;
            try_files $uri $uri/ =404;
        }

        location @hex_platform {
            proxy_pass http://127.0.0.1:8081;
            proxy_set_header Host $http_host;
        }

        location /api/ {
            proxy_pass http://127.0.0.1:8081;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_hide_header X-Hex-Analytics-User;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
            proxy_send_timeout 60s;
            proxy_buffering off;
        }

    }
}
