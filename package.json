{
  "name": "hex-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write \"packages/**/*.{ts,js,mjs,json,html,yaml,yml}\" \"scripts/**/*.mjs\" package.json",
    "format:check": "prettier --check \"packages/**/*.{ts,js,mjs,json,html,yaml,yml}\" \"scripts/**/*.mjs\" package.json",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "test:browser": "npm run build && node scripts/e2e.mjs --browser",
    "test:local": "npm run build && node scripts/test-external-server.mjs",
    "test:services": "npm run build && node scripts/test-services.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "prettier": "3.9.8",
    "undici": "7.29.1",
    "ws": "^8.21.3"
  }
}
