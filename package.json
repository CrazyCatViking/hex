{
  "name": "hex-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write \"packages/**/*.{ts,js,mjs,json,html}\" \"scripts/**/*.mjs\" package.json",
    "format:check": "prettier --check \"packages/**/*.{ts,js,mjs,json,html}\" \"scripts/**/*.mjs\" package.json",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run build && node scripts/e2e.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.8",
    "ws": "^8.21.3"
  }
}
