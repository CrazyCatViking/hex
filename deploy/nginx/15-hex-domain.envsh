#!/bin/sh
set -eu

domain=${HEX_SITE_DOMAIN:-localhost}
case "$domain" in
    ""|*[!a-z0-9.-]*|.*|*.|*..*)
        printf '%s\n' "HEX_SITE_DOMAIN must be a lowercase DNS hostname" >&2
        exit 1
        ;;
esac

HEX_SITE_DOMAIN_PATTERN=$(printf '%s' "$domain" | sed 's/\./\\./g')
export HEX_SITE_DOMAIN_PATTERN
